{
  "version": "1.0.0",
  "environment": "production",
  "domain": "serverroot.net",
  "swarm": {
    "default_agent_count": 8,
    "max_agents": 64,
    "platforms": [
      "linux",
      "windows",
      "router",
      "vpn"
    ],
    "leader_election_timeout": 30,
    "task_timeout": 300,
    "heartbeat_interval": 60,
    "intelligence_sharing": true
  },
  "api": {
    "host": "0.0.0.0",
    "port": 5001,
    "debug": false,
    "workers": 4,
    "cors_enabled": true,
    "websocket_enabled": true,
    "api_key_required": false,
    "api_key": ""
  },
  "c2": {
    "host": "0.0.0.0",
    "port": 8443,
    "max_connections": 100
  },
  "security": {
    "encryption_enabled": true,
    "audit_log_enabled": true,
    "input_validation": true,
    "api_key_required": false,
    "api_key": "",
    "tls_enabled": false
  },
  "performance": {
    "l1_cache_size": 100000,
    "l2_cache_size": 1000000,
    "result_cache_size": 50000,
    "thread_pool_size": 20,
    "max_threads": 100,
    "max_connections": 500,
    "memory_warning_pct": 80.0,
    "memory_critical_pct": 95.0
  },
  "reliability": {
    "health_check_interval": 30,
    "watchdog_restart_delay": 5.0,
    "state_snapshot_interval": 300,
    "state_dir": "data/snapshots",
    "max_snapshots": 48
  },
  "scanner": {
    "default_ports": "21,22,23,25,53,80,110,111,135,139,143,443,445,993,995,1723,3389,5900,8080,8443,8888",
    "scan_timeout": 300,
    "max_hosts_per_scan": 512,
    "deep_scan_enabled": true,
    "deep_scan_timeout": 600,
    "ai_confidence_threshold": 0.7
  },
  "ai": {
    "enabled": true,
    "openrouter_api_key": "",
    "model": "anthropic/claude-3.5-sonnet",
    "temperature": 0.3,
    "max_tokens": 4000,
    "enable_exploit_generation": true,
    "enable_vulnerability_analysis": true,
    "timeout": 300,
    "max_retries": 3
  },
  "exploitation": {
    "auto_exploit": false,
    "max_targets": null,
    "exploit_timeout": 60,
    "verify_success": true,
    "deploy_agent": true,
    "enable_intelligent_engine": true,
    "max_exploit_attempts": 3,
    "search_exploit_databases": true
  },
  "agent": {
    "sleep_time": 30,
    "heartbeat_interval": 60,
    "persistence": true,
    "stealth_mode": false,
    "enable_propagation": false,
    "max_propagation_depth": 2,
    "intelligence_sharing": true,
    "discovery_enabled": true
  },
  "detection": {
    "banner_grabbing": true,
    "http_fingerprinting": true,
    "service_enumeration": true,
    "misconfiguration_detection": true,
    "default_credential_detection": true,
    "cve_matching": true
  },
  "recorder": {
    "db_path": "data/recorder.db",
    "record_all_attempts": true,
    "capture_evidence": true,
    "chain_of_custody": true,
    "export_format": "json"
  },
  "database": {
    "intel_db": "data/intel.db",
    "c2_db": "data/c2_database.db",
    "backup_enabled": true,
    "backup_interval": 3600,
    "recorder_db_path": "data/recorder.db"
  },
  "logging": {
    "level": "INFO",
    "log_dir": "logs",
    "log_to_file": true,
    "log_to_console": true
  },
  "reporting": {
    "auto_generate": true,
    "include_poc": true,
    "format": "json",
    "generate_access_reports": true,
    "export_session_data": true
  },
  "dns": {
    "domain": "serverroot.net",
    "api_subdomain": "api.serverroot.net",
    "admin_email": "kevix@serverroot.net",
    "ttl": 300
  }
}
