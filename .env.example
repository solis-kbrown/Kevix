# ─────────────────────────────────────────────────────────────────────────────
# ServerRoot.net — Environment Configuration Template
# Copy this to .env and fill in your values
# cp .env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / OpenRouter ────────────────────────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
# Without this, the system runs in fallback mode (no LLM calls, everything else works)
OPENROUTER_API_KEY=

# ── Email Notifications ────────────────────────────────────────────────────────
# For Gmail: enable 2FA, then create an App Password at:
#   https://myaccount.google.com/apppasswords
# For SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<sendgrid-api-key>
# For Mailgun: SMTP_HOST=smtp.mailgun.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
FROM_NAME=ServerRoot.net

# ── Deployment ─────────────────────────────────────────────────────────────────
# Your VM's public IP (set after provisioning)
VM1_IP=
VM2_IP=
PEER_VM_IP=

# Domain name (set after DNS propagation)
DOMAIN=serverroot.net

# ── API Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5001
C2_HOST=0.0.0.0
C2_PORT=8443

# ── Frontend ───────────────────────────────────────────────────────────────────
# URL the Next.js frontend uses to reach the API
# In production on same server: http://localhost:5001
# If on separate VM: http://<vm1-ip>:5001
NEXT_PUBLIC_API_URL=http://localhost:5001

# ── Database ───────────────────────────────────────────────────────────────────
SERVERROOT_DIR=/workspace
DATA_DIR=/workspace/data
LOG_DIR=/workspace/logs

# ── Security ───────────────────────────────────────────────────────────────────
# Change this to a long random string in production
SECRET_KEY=change-me-to-something-long-and-random-in-production

# ── Optional ───────────────────────────────────────────────────────────────────
# Set to 'true' to enable debug logging
DEBUG=false
# Set to 'true' to enable verbose SQL logging
SQL_DEBUG=false